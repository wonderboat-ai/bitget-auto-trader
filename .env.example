# =============================================================
# Bybit Auto Trader - variáveis de ambiente
# Copie este arquivo para .env e preencha. NUNCA versione o .env.
# =============================================================

# Ambiente: "testnet" (padrão, sem dinheiro real) ou "mainnet"
ENVIRONMENT=testnet

# --- Chaves da TESTNET (gere em https://testnet.bybit.com) ---
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --- Chaves da MAINNET (só preencha quando for pra real) ---
BYBIT_MAINNET_API_KEY=
BYBIT_MAINNET_API_SECRET=

# --- Chaves da BITGET (destino do port; gere em bitget.com > API Management) ---
# A Bitget exige uma PASSPHRASE além de key/secret — você a escolhe ao criar a
# chave e ela não é recuperável depois. Sem ela nenhuma chamada assinada passa.
# Não existe testnet da Bitget via ccxt (urls['test'] é None): estas chaves são
# de MAINNET e movem dinheiro real. Permissões necessárias: leitura + trade de
# contratos. NUNCA habilitar saque.
BITGET_MAINNET_API_KEY=
BITGET_MAINNET_API_SECRET=
BITGET_MAINNET_API_PASSPHRASE=

# --- Anthropic (Claude) ---
# Usada por dossier_fetch.py (dossiê diário macro/on-chain) e, quando a Fase 3
# for ligada, por src/strategy/llm_strategy.py. Gere em https://console.anthropic.com
ANTHROPIC_API_KEY=

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
