# =============================================================
# Bybit Auto Trader - variáveis de ambiente
# Copie este arquivo para .env e preencha. NUNCA versione o .env.
# =============================================================

# Ambiente: "testnet" (padrão, sem dinheiro real) ou "mainnet"
ENVIRONMENT=testnet

# --- Chaves da TESTNET (gere em https://testnet.bybit.com) ---
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --- Chaves da MAINNET (só preencha quando for pra real) ---
BYBIT_MAINNET_API_KEY=
BYBIT_MAINNET_API_SECRET=

# --- Anthropic (Claude) ---
# Usada por dossier_fetch.py (dossiê diário macro/on-chain) e, quando a Fase 3
# for ligada, por src/strategy/llm_strategy.py. Gere em https://console.anthropic.com
ANTHROPIC_API_KEY=

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
